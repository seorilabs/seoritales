@@ -0,0 +1,70 @@
+"""Public export regression checks; no publishing files are modified."""
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from PIL import Image
+
+spec = importlib.util.spec_from_file_location('export_web', Path(__file__).with_name('export_web.py'))
+web = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(web)
+SOURCE = Path(__file__).resolve().parents[1] / 'books/01-sun-and-moon'
+
+class PublicationTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.book = self.root / '01-sun-and-moon'
+        self.out = self.root / 'out'
+        for directory in ('art', 'cover', 'kdp'):
+            (self.book / directory).mkdir(parents=True)
+        self.data = json.loads((SOURCE / 'book.json').read_text())
+        (self.book / 'kdp/metadata.json').write_text((SOURCE / 'kdp/metadata.json').read_text())
+        for name in ('cover-kdp.jpg','cover-art-square.png'):
+            Image.new('RGB',(24,24),'white').save(self.book / 'cover' / name)
+        for n in (1,4,8):
+            Image.new('RGB',(24,24),'green').save(self.book / 'art' / f'spread-{n:02d}.png')
+
+    def export(self, mode='preview', select=False):
+        self.data['meta']['web_publication']={'mode':mode}
+        self.data['meta']['distribution']['kdp_select']=select
+        (self.book / 'book.json').write_text(json.dumps(self.data))
+        return web.export_book(str(self.book),str(self.out))
+
+    def test_preview_omits_every_withheld_text_and_extra(self):
+        result=self.export()
+        self.assertEqual(len(result['story']),1)
+        self.assertEqual(result['webPublication']['mode'],'preview')
+        encoded=json.dumps(result,ensure_ascii=False)
+        for page in self.data['pages']:
+            if page.get('type')=='spread' and page['id']!=result['story'][0]['id']:
+                for text in page['text']+[page['alt']]:
+                    self.assertNotIn(text,encoded)
+        self.assertEqual(result['cultureNote']['body'],[])
+        self.assertEqual(result['glossary'],[])
+        self.assertEqual(result['previewSpreads'],['spread-01'])
+
+    def test_preview_removes_previous_export_images(self):
+        self.export('full')
+        result=self.export('preview')
+        images=set(p.name for p in (self.out/'images'/result['slug']).iterdir())
+        self.assertEqual(images,{'cover.webp','og.jpg','spread-01.webp'})
+
+    def test_select_always_restricts_full_and_does_not_control_preview(self):
+        self.assertEqual(len(self.export('full',True)['story']),1)
+        self.assertEqual(len(self.export('preview',False)['story']),1)
+        self.assertEqual(len(self.export('full',False)['story']),14)
+
+    def test_only_verified_purchase_links_are_public(self):
+        stores=self.data['meta']['distribution']['wide_stores']
+        stores['apple_books']={'status':'in_review','url':'https://books.apple.com/us/book/id123'}
+        stores['google_play_books']={'status':'buyable','purchase_verified':True,'verified_at':'2026-11-13T00:00:00Z','url':'https://play.google.com/store/books/details?id=example'}
+        self.assertEqual([s['store'] for s in self.export()['storeLinks']],['google_play_books'])
+        stores['google_play_books']['purchase_verified']=False
+        self.assertEqual(self.export()['storeLinks'],[])
+        stores['apple_books']={'status':'buyable','purchase_verified':True,'verified_at':'2026-11-13T00:00:00Z','url':'https://example.com/'}
+        self.assertEqual(self.export()['storeLinks'],[])
+
+if __name__=='__main__': unittest.main()
